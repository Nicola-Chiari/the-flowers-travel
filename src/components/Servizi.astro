---
import Img from './Img.astro';
import { single } from '../lib/content';

const s = await single('servizi');
const ui = await single('ui');
---

<section id="servizi" class="services">
  <p class="eyebrow">{s.eyebrow}</p>
  <h2 class="section-title services__title">{s.title}</h2>
  {s.intro && <p class="services__intro">{s.intro}</p>}
  <div class="services__grid">
    {
      s.items.map((item) => {
        const Tag = item.link ? 'a' : 'article';
        return (
          <Tag href={item.link || undefined} class:list={['services__card', { 'services__card--link': item.link }]}>
            {item.icon ? (
              <div class="services__icon">
                <Img src={item.icon} alt="" widths={[150, 300]} sizes="150px" />
              </div>
            ) : (
              <div class="services__icon services__icon--empty" aria-hidden="true" />
            )}
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            {item.link && (
              <p class="services__more" aria-hidden="true">
                {ui.more}
              </p>
            )}
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .services {
    padding: 100px var(--gutter);
    background: var(--white);
  }
  .services__title {
    margin: 0 auto 16px;
    white-space: nowrap;
  }
  .services__intro {
    font-size: 19px;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.7;
    text-align: center;
    max-width: 820px;
    margin: 0 auto 64px;
    text-wrap: balance;
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 36px;
    max-width: 1160px;
    margin: 0 auto;
    align-items: stretch;
  }
  .services__card {
    color: inherit;
    text-decoration: none;
    border: 1px solid rgba(26, 26, 26, 0.1);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 520px;
    padding: 44px 34px;
    gap: 24px;
    transition:
      transform var(--ease),
      box-shadow var(--ease),
      background var(--ease),
      border-color var(--ease);
  }
  .services__card:hover {
    box-shadow: var(--shadow-card);
    background: rgba(107, 120, 96, 0.18);
    border-color: var(--olive);
  }
  @media (prefers-reduced-motion: no-preference) {
    .services__card:hover {
      transform: scale(1.05);
    }
  }
  .services__icon {
    width: 140px;
    height: 150px;
    flex-shrink: 0;
    border-radius: var(--blob-1);
    transform: rotate(-4deg);
    overflow: hidden;
  }
  .services__icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: rotate(4deg);
  }
  .services__icon--empty {
    background: repeating-linear-gradient(45deg, var(--olive) 0 16px, var(--blush) 16px 32px);
  }
  .services__card h3 {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 21px;
    color: var(--plum);
    margin: 0;
  }
  .services__card p {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.72;
    margin: 0;
  }
  .services__card .services__more {
    font-family: var(--font-script);
    font-size: 34px;
    line-height: 1;
    color: var(--plum);
    margin: auto 0 0;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .services__card:hover .services__more,
  .services__card:focus-visible .services__more {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .services__card .services__more {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 759px) {
    .services__title {
      white-space: normal;
    }
    .services__card {
      min-height: 0;
    }
  }
</style>
