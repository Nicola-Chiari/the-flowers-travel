---
// Sezione testo + immagine a forma organica (Nozze, Famiglia).
import Img from './Img.astro';
import { single } from '../lib/content';

interface Props {
  id: 'nozze' | 'famiglia';
}
const { id } = Astro.props;
const f = await single(id);
const isNozze = id === 'nozze';
---

<section id={id} class:list={['feature', `feature--${id}`]}>
  <div class="feature__text">
    <p class="feature__eyebrow">{f.eyebrow}</p>
    <h2 class="feature__title">{f.title}</h2>
    <p class="feature__body">{f.text}</p>
    <a
      href={f.link}
      class:list={['btn', isNozze ? 'btn--blush' : 'btn--alt btn--olive']}
      data-trip-filter={f.filter || undefined}
    >
      {f.cta}
    </a>
  </div>
  <div class:list={['feature__media', { 'feature__media--empty': !f.image }]}>
    {
      f.image && (
        <Img
          src={f.image}
          alt={f.imageAlt || f.title}
          widths={[600, 900, 1200]}
          sizes="(max-width: 759px) 88vw, 600px"
        />
      )
    }
  </div>
</section>

<style>
  .feature {
    background: var(--white);
    color: var(--ink);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 60px;
    align-items: center;
  }
  .feature--nozze {
    padding: 110px var(--gutter);
  }
  .feature--famiglia {
    padding: 72px var(--gutter) 110px;
  }
  .feature--nozze .feature__text {
    position: relative;
    top: -19px;
  }
  .feature--famiglia .feature__text {
    order: 2;
  }
  .feature__media {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 600px;
    height: 540px;
    justify-self: center;
    overflow: hidden;
  }
  .feature--nozze .feature__media {
    margin-top: -104px;
    border-radius: 55% 45% 52% 48% / 48% 58% 42% 52%;
    transform: rotate(-3deg);
  }
  .feature--famiglia .feature__media {
    order: 1;
    margin-bottom: -104px;
    border-radius: 46% 54% 44% 56% / 56% 46% 54% 44%;
    transform: rotate(3deg);
    background: var(--rose);
  }
  .feature__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature--nozze .feature__media :global(img) {
    transform: rotate(3deg) scale(1.08);
  }
  .feature--famiglia .feature__media :global(img) {
    object-position: 50% 62%;
    transform: rotate(-3deg) scale(1.08);
  }
  .feature--nozze .feature__media--empty {
    background: repeating-linear-gradient(135deg, var(--blush) 0 30px, var(--ink) 30px 60px);
  }
  .feature--famiglia .feature__media--empty {
    background: repeating-linear-gradient(135deg, var(--rose) 0 30px, var(--olive) 30px 60px);
  }
  .feature__eyebrow {
    font-family: var(--font-script);
    font-size: 58px;
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 16px;
  }
  .feature--nozze .feature__eyebrow {
    color: var(--blush);
  }
  .feature--famiglia .feature__eyebrow {
    color: var(--olive);
  }
  .feature__title {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: var(--h2-size);
    line-height: 1.2;
    margin: 0 0 24px;
    color: var(--ink);
  }
  .feature__body {
    font-size: 19px;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.75;
    max-width: 460px;
    margin: 0 0 32px;
  }
  @media (max-width: 759px) {
    .feature {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .feature--nozze,
    .feature--famiglia {
      padding: 80px var(--gutter);
    }
    .feature__media {
      height: 340px;
      margin: 0 !important;
    }
    .feature--famiglia .feature__text {
      order: 0;
    }
    .feature__eyebrow {
      font-size: 46px;
    }
  }
</style>
