---
import Postcard from './Postcard.astro';
import WaveEdge from './WaveEdge.astro';
import { getViaggi, single } from '../lib/content';

const intro = await single('viaggiIntro');
const ui = await single('ui');
const site = await single('site');
const viaggi = await getViaggi();
const used = new Set(viaggi.map((v) => v.data.category));
const categories = intro.categories.map((c) => c.name).filter((name) => used.has(name));
const plane =
  'M8.2 0.1 C 4 -0.9, -3.8 -0.5, -7.9 0.2 C -4.1 0.9, 4.2 0.8, 8.2 0.1 M2.6 -0.5 L -0.6 -6.4 L -2.4 -6.1 L -1.3 -0.6 M2.4 0.6 L -0.9 6.2 L -2.6 5.8 L -1.2 0.7 M-5.6 -0.3 L -7.4 -3.3 L -8.4 -3 L -7.6 -0.1 M-5.5 0.5 L -7.5 3.4 L -8.5 3 L -7.5 0.4';
const REPEAT = 16;
---

<section id="viaggi" class="trips">
  <WaveEdge position="top" color="#6b7860" />
  <WaveEdge position="bottom" color="#6b7860" />

  <div class="trips__head">
    <p class="eyebrow">{intro.eyebrow}</p>
    <h2 class="section-title trips__title">{intro.title}</h2>
    {intro.subtitle && <p class="section-intro trips__subtitle">{intro.subtitle}</p>}
    <div class="trips__filters" role="group" aria-label={intro.title}>
      {
        [intro.allLabel, ...categories].map((label, i) => (
          <button type="button" class="trips__filter" data-filter={i === 0 ? '' : label} aria-pressed={i === 0 ? 'true' : 'false'}>
            {label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="trips__carousel">
    <button type="button" class="trips__arrow trips__arrow--prev" data-dir="-1" aria-label={ui.carouselPrev}>
      <svg width="46" height="20" viewBox="0 0 46 20" fill="none" aria-hidden="true"
        ><path d="M45 10 Q 41.5 6 38 10 T 31 10 T 24 10 T 17 10 T 10 10 T 3 10" stroke="#E6B84A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        ></path><path d="M2 10L11 3M2 10L11 17" stroke="#E6B84A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </button>
    <button type="button" class="trips__arrow trips__arrow--next" data-dir="1" aria-label={ui.carouselNext}>
      <svg width="46" height="20" viewBox="0 0 46 20" fill="none" aria-hidden="true"
        ><path d="M1 10 Q 4.5 6 8 10 T 15 10 T 22 10 T 29 10 T 36 10 T 43 10" stroke="#E6B84A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        ></path><path d="M44 10L35 3M44 10L35 17" stroke="#E6B84A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </button>

    <div class="trips__rail" data-rail tabindex="0" aria-label={intro.title}>
      {
        viaggi.map((trip, i) => (
          <div class="trips__slide" data-category={trip.data.category}>
            <Postcard trip={trip} eager={i === 0} sideWaves />
          </div>
        ))
      }
    </div>
  </div>

  <svg class="trips__ribbon" viewBox="0 0 1440 120" aria-hidden="true" data-ribbon>
    <path
      id="tft-ribbon-path"
      d="M-60,58 C90,74 200,78 360,56 C540,34 720,38 900,62 C1080,86 1260,82 1500,58"
      stroke="#FFFFFF"
      stroke-width="63"
      fill="none"
      stroke-linecap="butt"></path>
    <text class="trips__ribbon-text" dominant-baseline="central"
      ><textPath href="#tft-ribbon-path" startOffset="0" data-ribbon-text
        >{Array.from({ length: REPEAT }, (_, i) => <tspan dx={i === 0 ? undefined : 76}>{site.tagline}</tspan>)}</textPath
      ></text
    >
    <g data-ribbon-planes fill="none" stroke="#542833" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      {Array.from({ length: REPEAT }, () => <path visibility="hidden" d={plane} />)}
    </g>
  </svg>
</section>

<style>
  .trips {
    position: relative;
    z-index: 1;
    padding: 100px var(--gutter) 120px;
    background: var(--olive);
  }
  .trips__head {
    position: relative;
    top: -57px;
  }
  .trips__title {
    margin: 14px 0;
    color: var(--white);
  }
  .trips__subtitle {
    color: var(--white);
    opacity: 0.85;
    margin-bottom: 40px;
  }
  .trips__filters {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .trips__filter {
    padding: 10px 20px;
    border-radius: var(--petal-alt);
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    color: var(--white);
    font-size: 15.4px;
    letter-spacing: 0.03em;
    cursor: pointer;
    font-family: var(--font-body);
    transition: transform var(--ease);
  }
  .trips__filter[aria-pressed='true'] {
    border-color: var(--blush);
    background: var(--blush);
  }
  .trips__filter:hover {
    background: rgba(226, 125, 115, 0.35);
    border-color: var(--blush);
  }
  @media (prefers-reduced-motion: no-preference) {
    .trips__filter:hover {
      transform: scale(1.08);
    }
    .trips__filter:active {
      transform: scale(0.94);
    }
  }

  .trips__carousel {
    position: relative;
    top: -38px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .trips__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    border: none;
    background: none;
    cursor: pointer;
    padding: 10px;
    transition: transform 0.2s ease;
    transform: translateY(-50%) scaleX(1);
  }
  .trips__arrow svg {
    display: block;
  }
  .trips__arrow--prev {
    left: -30px;
    transform-origin: right center;
  }
  .trips__arrow--next {
    right: -30px;
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .trips__arrow:hover {
      transform: translateY(-50%) scaleX(1.2);
    }
  }
  .trips__rail {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 24px 0 36px;
    margin: -20px 0 -16px;
    scrollbar-width: none;
    outline-offset: 6px;
  }
  .trips__rail::-webkit-scrollbar {
    display: none;
  }
  .trips__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    justify-content: center;
    padding: 0 60px;
  }
  .trips__slide[hidden] {
    display: none;
  }

  .trips__ribbon {
    position: absolute;
    left: 0;
    bottom: -96px;
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    pointer-events: none;
    z-index: 3;
  }
  .trips__ribbon-text {
    font-family: var(--font-script);
    font-size: 38px;
    fill: var(--plum);
  }

  @media (max-width: 759px) {
    .trips {
      padding-bottom: 130px;
      overflow-x: clip;
      overflow-y: visible;
    }
    .trips__head {
      top: -30px;
    }
    .trips__carousel {
      top: -20px;
    }
    .trips__arrow {
      display: none;
    }
    .trips__slide {
      padding: 0 8px;
    }
    /* Nastro più largo dello schermo: la scritta resta leggibile */
    .trips__ribbon {
      width: 260%;
      left: -80%;
      bottom: -110px;
    }
  }
</style>

<script>
  const section = document.getElementById('viaggi');
  if (section) {
    const rail = section.querySelector<HTMLElement>('[data-rail]')!;
    const slides = [...section.querySelectorAll<HTMLElement>('.trips__slide')];
    const filters = [...section.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const behavior = (): ScrollBehavior => (reduced.matches ? 'auto' : 'smooth');

    const slideBy = (dir: number) => rail.scrollBy({ left: dir * rail.clientWidth, behavior: behavior() });
    section.querySelectorAll<HTMLButtonElement>('.trips__arrow').forEach((b) =>
      b.addEventListener('click', () => slideBy(Number(b.dataset.dir))),
    );
    rail.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        slideBy(e.key === 'ArrowRight' ? 1 : -1);
      }
    });

    const applyFilter = (category: string) => {
      const known = filters.some((f) => f.dataset.filter === category);
      const c = known ? category : '';
      filters.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.filter === c)));
      slides.forEach((s) => (s.hidden = c !== '' && s.dataset.category !== c));
      rail.scrollTo({ left: 0, behavior: 'auto' });
    };
    filters.forEach((f) => f.addEventListener('click', () => applyFilter(f.dataset.filter ?? '')));
    // Pulsanti di altre sezioni (es. "Scopri i viaggi di nozze") possono scegliere il filtro.
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-trip-filter]');
      if (trigger) applyFilter(trigger.dataset.tripFilter ?? '');
    });

    // Nastro "Dream, smile, go!" che scorre lungo l'onda, con gli aeroplanini tra le frasi.
    const tp = section.querySelector<SVGTextPathElement>('[data-ribbon-text]');
    const path = section.querySelector<SVGPathElement>('#tft-ribbon-path');
    const planes = [...section.querySelectorAll<SVGPathElement>('[data-ribbon-planes] path')];
    const ribbon = section.querySelector<SVGSVGElement>('[data-ribbon]');
    if (tp && path && ribbon && !reduced.matches) {
      const GAP = 76;
      let unit = 0;
      let phrase = 0;
      let off = 0;
      let last = performance.now();
      let raf = 0;
      const measure = () => {
        try {
          const first = tp.querySelector('tspan');
          phrase = first ? first.getComputedTextLength() : 0;
          unit = phrase + GAP;
        } catch {
          unit = 0;
        }
      };
      const step = (now: number) => {
        const dt = Math.min(now - last, 100);
        last = now;
        if (!unit) measure();
        if (unit > 0) {
          off = (off + dt * 0.06) % unit;
          tp.setAttribute('startOffset', String(-off));
          const total = path.getTotalLength();
          planes.forEach((p, k) => {
            const s = -off + k * unit + phrase + GAP / 2;
            if (s < 2 || s > total - 2) return p.setAttribute('visibility', 'hidden');
            const a = path.getPointAtLength(s);
            const b = path.getPointAtLength(Math.min(total, s + 1));
            const ang = (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI + 180;
            p.setAttribute('transform', `translate(${a.x.toFixed(1)} ${a.y.toFixed(1)}) rotate(${ang.toFixed(1)}) scale(0.85)`);
            p.setAttribute('visibility', 'visible');
          });
        }
        raf = requestAnimationFrame(step);
      };
      document.fonts?.ready.then(() => (unit = 0));
      // Anima solo quando il nastro è visibile.
      new IntersectionObserver(([e]) => {
        cancelAnimationFrame(raf);
        if (e.isIntersecting) {
          last = performance.now();
          raf = requestAnimationFrame(step);
        }
      }).observe(ribbon);
    }
  }
</script>
