---
import Img from './Img.astro';
import SocialIcon from './SocialIcon.astro';
import WaveEdge from './WaveEdge.astro';
import { single } from '../lib/content';

const site = await single('site');
const ui = await single('ui');
const socialLabels = { instagram: 'Instagram', tiktok: 'TikTok', facebook: 'Facebook', pinterest: 'Pinterest' } as const;
const socials = (Object.keys(socialLabels) as (keyof typeof socialLabels)[])
  .map((key) => ({ key, label: socialLabels[key], url: site.socials[key] }))
  .filter((s) => s.url);
const year = new Date().getFullYear();
const [copyBefore, copyAfter = ''] = ui.footer.copyright.split('{anno}');
const divider = 'M8 2 C 0 12, 0 22, 8 32 S 16 52, 8 62 S 0 82, 8 92 S 16 112, 8 118';
---

<footer class="footer">
  <WaveEdge position="top" color="#6b7860" />
  <div class="footer__row">
    <div class="footer__brand">
      <Img src={site.logoFooter} alt="The Flowers Travel" class="footer__logo" widths={[200, 400]} sizes="195px" />
      <p class="footer__tagline">{site.tagline}</p>
    </div>
    <svg class="footer__divider" width="16" height="120" viewBox="0 0 16 120" fill="none" aria-hidden="true"
      ><path d={divider} stroke="#d9bec2" stroke-width="3" stroke-linecap="round"></path></svg
    >
    <div class="footer__info">
      {
        site.taxId && (
          <p>
            {site.taxLabel && <span>{site.taxLabel}</span>} {site.taxId}
          </p>
        )
      }
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    {
      socials.length > 0 && (
        <>
          <svg class="footer__divider" width="16" height="120" viewBox="0 0 16 120" fill="none" aria-hidden="true">
            <path d={divider} stroke="#d9bec2" stroke-width="3" stroke-linecap="round" />
          </svg>
          <div class="footer__social">
            <p class="footer__social-title">{ui.footer.socialTitle}</p>
            <div class="footer__icons">
              {socials.map((s) => (
                <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}>
                  <SocialIcon name={s.key} />
                </a>
              ))}
            </div>
          </div>
        </>
      )
    }
  </div>

  <div class="footer__bottom">
    <p>{copyBefore}<span data-year>{year}</span>{copyAfter}</p>
    <div class="footer__legal">
      <a href="/privacy">{ui.footer.privacy}</a>
      <a href="/cookie">{ui.footer.cookie}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: 90px var(--gutter) 40px;
    background: var(--olive);
    color: var(--white);
  }
  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto 64px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .footer :global(.footer__logo) {
    height: 65px;
    width: auto;
    max-width: none;
    margin-bottom: 16px;
    display: block;
  }
  .footer__tagline {
    font-family: var(--font-script);
    font-size: 34px;
    line-height: 1.2;
    margin: 0;
  }
  .footer__divider {
    display: block;
    flex: 0 0 auto;
  }
  .footer__info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 17px;
  }
  .footer__info p {
    margin: 0;
  }
  .footer__info a {
    color: var(--white);
    text-decoration: none;
  }
  .footer__info a:hover {
    color: var(--blush);
  }
  .footer__social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    align-self: flex-end;
  }
  .footer__social-title {
    margin: 0;
    font-family: var(--font-script);
    font-size: 34px;
    line-height: 1.1;
    position: relative;
    top: -10px;
  }
  .footer__icons {
    display: flex;
    gap: 12px;
  }
  .footer__icons a {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid var(--plum);
    color: var(--plum);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background var(--ease),
      transform var(--ease);
  }
  .footer__icons a:hover {
    background: var(--blush);
  }
  @media (prefers-reduced-motion: no-preference) {
    .footer__icons a:hover {
      transform: scale(1.08);
    }
  }
  .footer__bottom {
    max-width: 1200px;
    margin: 0 auto;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 16px;
    opacity: 0.55;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__legal {
    display: flex;
    gap: 24px;
  }
  .footer__legal a {
    color: var(--white);
    text-decoration: none;
  }
  .footer__legal a:hover {
    text-decoration: underline;
  }
  @media (max-width: 759px) {
    .footer__row {
      flex-direction: column;
      gap: 28px;
    }
    .footer__divider {
      display: none;
    }
    .footer__info {
      align-items: center;
      text-align: center;
    }
    .footer__social {
      align-self: center;
    }
    .footer__bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>
