---
// Francobollo dentellato + timbro di annullo, in alto a destra nella cartolina.
interface Props {
  country: string;
  mark: string;
  value: string;
  year: string;
  class?: string;
}
const { country, mark, value, year, class: className } = Astro.props;
---

<div class:list={['stamp', className]} aria-hidden="true">
  <div class="stamp__paper">
    <div class="stamp__inner">
      <span class="stamp__country">{country}</span>
      <span class="stamp__mark">{mark}</span>
      <span class="stamp__value">{value}</span>
    </div>
  </div>
  <div class="stamp__postmark">
    <div class="stamp__postmark-inner">
      <span class="stamp__pm-text">Flowers</span>
      <span class="stamp__pm-year">{year}</span>
      <span class="stamp__pm-text">Travel</span>
    </div>
  </div>
  <div class="stamp__waves"></div>
</div>

<style>
  .stamp {
    position: absolute;
    top: 26px;
    right: 30px;
    width: 150px;
    height: 104px;
    pointer-events: none;
    z-index: 2;
  }
  .stamp__paper {
    position: absolute;
    top: 0;
    right: 0;
    width: 76px;
    height: 92px;
    padding: 6px;
    transform: rotate(4deg);
    background: radial-gradient(circle at 6px 6px, #ffffff 3.2px, var(--blush) 3.8px) -6px -6px / 12px 12px;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.12));
  }
  .stamp__inner {
    width: 100%;
    height: 100%;
    background: var(--blush-light);
    border: 1px solid #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 6px 4px;
    color: var(--sage-dark);
    text-align: center;
    overflow: hidden;
  }
  .stamp__country {
    font-family: var(--font-body);
    font-size: 7px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: clip;
  }
  .stamp__mark {
    font-family: var(--font-script);
    font-size: 22px;
    line-height: 1;
  }
  .stamp__value {
    font-family: var(--font-title);
    font-size: 9px;
  }
  .stamp__postmark {
    position: absolute;
    top: 22px;
    right: 46px;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    border: 1.5px solid rgba(85, 107, 107, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-12deg);
  }
  .stamp__postmark-inner {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(85, 107, 107, 0.5);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
  }
  .stamp__pm-text {
    font-family: var(--font-body);
    font-size: 6px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(85, 107, 107, 0.75);
  }
  .stamp__pm-year {
    font-family: var(--font-title);
    font-size: 9px;
    color: rgba(85, 107, 107, 0.8);
  }
  .stamp__waves {
    position: absolute;
    top: 40px;
    left: 0;
    width: 70px;
    height: 30px;
    transform: rotate(-12deg);
    background: repeating-linear-gradient(
      180deg,
      transparent 0px,
      transparent 5px,
      rgba(85, 107, 107, 0.5) 5px,
      rgba(85, 107, 107, 0.5) 6.5px
    );
    -webkit-mask: linear-gradient(90deg, transparent, #000 40%);
    mask: linear-gradient(90deg, transparent, #000 40%);
  }
</style>
