---
import Img from './Img.astro';
import { single, splitMarker, stripMarkers } from '../lib/content';

const c = await single('chiSono');

// [[foto]] nel titolo = dove inizia la foto; [[/foto]] in un paragrafo = dove finisce.
const titleParts = splitMarker(stripMarkers(c.title.replace('[[foto]]', '\u0000')), '\u0000');
const paragraphs = c.paragraphs.map((p) => {
  const parts = splitMarker(stripMarkers(p.replace('[[/foto]]', '\u0000')), '\u0000');
  return parts ?? stripMarkers(p);
});
const lists = [
  { title: c.whyTitle, items: c.whyItems },
  { title: c.valuesTitle, items: c.valuesItems },
];
---

<section id="chi-sono" class="about">
  <p class="about__eyebrow">{c.eyebrow}</p>
  <div class="about__grid" data-about>
    <div class="about__photo" data-photo-cell>
      <Img
        src={c.photo}
        alt={c.photoAlt}
        widths={[400, 600, 920, 1080]}
        sizes="(max-width: 759px) 88vw, 460px"
        data-photo
      />
    </div>
    <div class="about__text" data-photo-text>
      <h2 class="about__title">
        {
          titleParts ? (
            <>
              {titleParts[0]}
              <span data-photo-start />
              {titleParts[1]}
            </>
          ) : (
            stripMarkers(c.title)
          )
        }
      </h2>
      {
        paragraphs.map((p) =>
          Array.isArray(p) ? (
            <p>
              {p[0]}
              <span data-photo-end />
              {p[1]}
            </p>
          ) : (
            <p>{p}</p>
          ),
        )
      }
    </div>
  </div>

  <div class="about__columns">
    {
      lists.map((l) => (
        <div class="about__col">
          <p class:list={['about__col-title', { 'about__col-title--alone': l.items.length === 0 }]}>{l.title}</p>
          {l.items.length > 0 && (
            <ul class="about__list">
              {l.items.map((item) => (
                <li>
                  <span class="about__dot" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
    <span class="about__divider" aria-hidden="true"></span>
  </div>
</section>

<style>
  .about {
    padding: 110px var(--gutter);
    background: var(--sage);
  }
  .about__eyebrow {
    font-family: var(--font-script);
    font-size: 62px;
    letter-spacing: 0.02em;
    font-weight: 600;
    color: var(--ink);
    opacity: 0.6;
    margin: 0 0 40px;
    text-align: center;
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 60px;
    align-items: stretch;
    margin-left: -38px;
  }
  .about__photo {
    position: relative;
    width: 460px;
    max-width: 100%;
    overflow: hidden;
    justify-self: center;
  }
  .about__photo :global([data-photo]) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 100%;
  }
  .about__text {
    max-width: calc(100% - 25px);
  }
  .about__title {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: var(--h2-size);
    line-height: 1.2;
    margin: 0 0 24px;
    color: var(--white);
  }
  .about__text p {
    font-size: 19px;
    line-height: 1.75;
    color: var(--white);
    opacity: 0.9;
    margin: 0 0 20px;
  }
  .about__text p:last-child {
    margin-bottom: 36px;
  }

  .about__columns {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1100px;
    margin: 70px auto 0;
  }
  .about__col {
    text-align: center;
  }
  .about__col:first-child {
    padding-right: 50px;
  }
  .about__col:nth-child(2) {
    padding-left: 50px;
  }
  .about__divider {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.3);
  }
  .about__col-title {
    font-family: var(--font-script);
    font-size: 46px;
    letter-spacing: 0.02em;
    font-weight: 600;
    color: var(--ink);
    opacity: 0.6;
    margin: 0 0 24px;
  }
  .about__col-title--alone {
    margin: 0;
  }
  .about__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }
  .about__list li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
  }
  .about__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.6;
    flex-shrink: 0;
  }

  @media (max-width: 759px) {
    .about {
      padding: 90px var(--gutter);
    }
    .about__eyebrow {
      font-size: 52px;
    }
    .about__grid {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-left: 0;
    }
    .about__photo {
      width: 100%;
      aspect-ratio: 4 / 5;
    }
    .about__text {
      max-width: 100%;
    }
    .about__columns {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 56px;
    }
    .about__col:first-child,
    .about__col:nth-child(2) {
      padding: 0;
    }
    .about__col:nth-child(2) {
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.3);
    }
    .about__divider {
      display: none;
    }
  }
</style>

<script>
  // Allinea la foto: bordo alto = inizio di [[foto]], bordo basso = inizio di [[/foto]].
  // Senza marcatori la foto occupa l'altezza del blocco di testo.
  const cell = document.querySelector<HTMLElement>('[data-photo-cell]');
  const text = document.querySelector<HTMLElement>('[data-photo-text]');
  const photo = cell?.querySelector<HTMLImageElement>('img[data-photo]');
  const start = text?.querySelector<HTMLElement>('[data-photo-start]');
  const end = text?.querySelector<HTMLElement>('[data-photo-end]');
  const stacked = matchMedia('(max-width: 759px)');

  function measure() {
    if (!cell || !text || !photo) return;
    if (stacked.matches) {
      photo.style.top = '';
      photo.style.height = '';
      return;
    }
    const base = cell.getBoundingClientRect().top;
    const t = text.getBoundingClientRect();
    const top = (start ? start.getBoundingClientRect().top : t.top) - base;
    const bottom = (end ? end.getBoundingClientRect().top : t.bottom) - base;
    if (bottom - top < 80) return;
    photo.style.top = Math.round(top) + 'px';
    photo.style.height = Math.round(bottom - top) + 'px';
  }

  measure();
  document.fonts?.ready.then(measure);
  window.addEventListener('load', measure);
  if (text) new ResizeObserver(measure).observe(text);
  stacked.addEventListener('change', measure);
</script>
