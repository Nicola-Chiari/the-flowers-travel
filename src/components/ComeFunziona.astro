---
import Img from './Img.astro';
import { single } from '../lib/content';

const c = await single('comeFunziona');
// Ogni cerchio ha una forma e un'inclinazione diversa.
const shapes = ['var(--blob-1)', 'var(--blob-2)', 'var(--blob-3)', 'var(--blob-4)'];
const tilts = [-4, 5, -6, 3];
---

<section id="come-funziona" class="steps">
  <p class="eyebrow">{c.eyebrow}</p>
  <h2 class="section-title steps__title">{c.title}</h2>
  <ol class="steps__list">
    {
      c.steps.map((step, i) => (
        <li class="steps__item">
          <div
            class:list={['steps__img', { 'steps__img--empty': !step.image }]}
            style={`border-radius: ${shapes[i % 4]}; transform: rotate(${tilts[i % 4]}deg);`}
            aria-hidden="true"
          >
            {step.image && <Img src={step.image} alt="" widths={[100, 200, 300]} sizes="100px" />}
          </div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </li>
      ))
    }
  </ol>
  {
    c.cta && c.ctaLink && (
      <div class="steps__cta">
        <a href={c.ctaLink} class="btn btn--plum">
          {c.cta}
        </a>
      </div>
    )
  }
</section>

<style>
  .steps {
    padding: 36px var(--gutter) 170px;
    background: var(--white);
  }
  .steps__title {
    margin-bottom: 64px;
  }
  .steps__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .steps__item {
    flex: 1 1 220px;
    max-width: 260px;
    text-align: center;
  }
  .steps__img {
    width: 100px;
    height: 108px;
    margin: 0 auto 20px;
    overflow: hidden;
  }
  .steps__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .steps__img--empty {
    background: repeating-linear-gradient(45deg, var(--olive) 0 14px, var(--blush) 14px 28px);
  }
  .steps__item h3 {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: 20px;
    margin: 0 0 10px;
  }
  .steps__item p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
    opacity: 0.7;
    margin: 0;
  }
  .steps__cta {
    text-align: center;
    margin-top: 94px;
  }
  @media (max-width: 759px) {
    .steps {
      padding-bottom: 130px;
    }
    .steps__cta {
      margin-top: 56px;
    }
  }
</style>
