---
// Onda dorata decorativa (separatori, box contatti).
interface Props {
  width?: number;
  height?: number;
  strokeWidth?: number;
  class?: string;
}
const { width = 250, height = 16, strokeWidth = 3, class: className } = Astro.props;
---

<svg class={className} width={width} height={height} viewBox="0 0 250 16" fill="none" aria-hidden="true"
  ><path
    d="M2 8 C 14 0, 26 0, 38 8 S 62 16, 74 8 S 98 0, 110 8 S 134 16, 146 8 S 170 0, 182 8 S 206 16, 218 8 S 242 0, 248 6"
    stroke="#E6B84A"
    stroke-width={strokeWidth}
    stroke-linecap="round"></path></svg
>
