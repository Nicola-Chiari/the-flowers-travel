---
import Img from './Img.astro';
import { single } from '../lib/content';

interface Props {
  /** "" sulla home (ancore locali), "/" nelle altre pagine. */
  base?: string;
  /** Nelle pagine interne la nav è sempre visibile. */
  alwaysVisible?: boolean;
}
const { base = '', alwaysVisible = false } = Astro.props;
const ui = await single('ui');
const site = await single('site');
const seo = site.seo;
---

<nav class="nav" data-nav data-always={alwaysVisible ? '' : undefined} aria-label={seo.title}>
  <a href={`${base}#hero`} class="nav__logo">
    <Img src={site.logoNav} alt="The Flowers Travel" widths={[120, 240]} sizes="120px" loading="eager" />
  </a>
  <div class="nav__links" id="nav-links">
    {
      ui.nav.map((l) => (
        <a href={`${base}#${l.target}`} data-nav-link={l.target}>
          {l.label}
        </a>
      ))
    }
  </div>
  <button
    class="nav__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-links"
    data-label-open={ui.navMenuOpen}
    data-label-close={ui.navMenuClose}
    aria-label={ui.navMenuOpen}
  >
    <span></span><span></span><span></span>
  </button>
</nav>

<style>
  .nav {
    position: fixed;
    top: 18px;
    left: 50%;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 18px 40px;
    background: rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    box-shadow: var(--shadow-nav);
    flex-wrap: nowrap;
    max-width: 92vw;
    transition:
      transform 0.35s ease,
      opacity 0.35s ease;
    transform: translateX(-50%) translateY(-140%);
    opacity: 0;
    pointer-events: none;
  }
  .nav.is-visible,
  .nav[data-always],
  .nav:focus-within {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .nav__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    transition: transform var(--ease);
  }
  .nav__logo :global(img) {
    height: 36px;
    width: auto;
    max-width: none;
    display: block;
  }
  .nav__links {
    display: flex;
    gap: 22px;
    font-size: 18px;
    white-space: nowrap;
  }
  .nav__links a {
    color: var(--ink);
    text-decoration: none;
    opacity: 0.75;
    font-weight: 400;
    display: inline-block;
    transition:
      transform 0.2s ease,
      color 0.2s ease,
      font-weight 0.2s ease;
  }
  .nav__links a:hover {
    color: var(--blush);
    font-weight: 600;
  }
  .nav__links a.is-active {
    color: var(--blush);
    opacity: 1;
    font-weight: 700;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav__logo:hover {
      transform: scale(1.12);
    }
    .nav__links a:hover {
      transform: scale(1.1);
    }
  }

  .nav__toggle {
    display: none;
    width: 40px;
    height: 40px;
    padding: 10px 8px;
    border: none;
    background: none;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
  }
  .nav__toggle span {
    display: block;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .nav__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(8.25px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav__toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-8.25px) rotate(-45deg);
  }

  @media (max-width: 899px) {
    .nav {
      width: 92vw;
      justify-content: space-between;
      padding: 12px 16px 12px 24px;
    }
    .nav__toggle {
      display: flex;
    }
    .nav__links {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 4px;
      padding: 14px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.4);
      border-radius: 24px;
      box-shadow: var(--shadow-nav);
      opacity: 0;
      transform: translateY(-8px);
      visibility: hidden;
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        visibility 0.25s;
    }
    .nav.is-open .nav__links {
      opacity: 1;
      transform: none;
      visibility: visible;
    }
    .nav__links a {
      padding: 12px 14px;
      opacity: 0.85;
    }
    .nav__links a:hover {
      transform: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const toggle = nav.querySelector<HTMLButtonElement>('.nav__toggle')!;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const sectionIds = [...document.querySelectorAll<HTMLElement>('main section[id]')].map((s) => s.id);
    const always = nav.hasAttribute('data-always');

    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) || '');
    };
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
    links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    let ticking = false;
    const update = () => {
      ticking = false;
      if (!always) {
        const visible = window.scrollY > 40;
        nav.classList.toggle('is-visible', visible);
        if (!visible) setOpen(false);
      }
      let current = sectionIds[0];
      for (const id of sectionIds) {
        const el = document.getElementById(id);
        if (el && el.offsetParent !== null && el.getBoundingClientRect().top <= 140) current = id;
      }
      links.forEach((a) => a.classList.toggle('is-active', a.dataset.navLink === current));
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
