---
import Img from './Img.astro';
import { single } from '../lib/content';

interface Props {
  /** "" sulla home (ancore locali), "/" nelle altre pagine. */
  base?: string;
  /** Nelle pagine interne la nav è sempre visibile. */
  alwaysVisible?: boolean;
}
const { base = '' } = Astro.props;
const alwaysVisible = Astro.props.alwaysVisible ?? false;
const ui = await single('ui');
const site = await single('site');

// "#sezione" diventa "/#sezione" fuori dalla home; gli altri link restano come sono.
const href = (link: string) => (link.startsWith('#') ? `${base}${link}` : link);
const section = (link: string) => (link.startsWith('#') ? link.slice(1) : undefined);
---

<nav class="nav" data-nav data-always={alwaysVisible ? '' : undefined} aria-label={site.seo.title}>
  <a href={`${base}#hero`} class="nav__logo">
    <Img src={site.logoNav} alt="The Flowers Travel" widths={[120, 240]} sizes="120px" loading="eager" />
  </a>

  <ul class="nav__links">
    {
      ui.nav.map((item) => (
        <li class:list={['nav__item', { 'nav__item--parent': item.children.length > 0 }]}>
          <a href={href(item.link)} class="nav__link wave-underline" data-nav-link={section(item.link)}>
            {item.label}
          </a>
          {item.children.length > 0 && (
            <ul class="nav__dropdown">
              {item.children.map((child, i) => (
                <li style={`--i: ${i}`}>
                  <a href={href(child.link)}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  <button
    class="nav__burger"
    type="button"
    aria-expanded="false"
    aria-controls="nav-panel"
    data-label-open={ui.navMenuOpen}
    data-label-close={ui.navMenuClose}
    aria-label={ui.navMenuOpen}
  >
    <svg width="26" height="20" viewBox="0 0 26 20" fill="none" stroke="#542833" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"
      ><path d="M2 3 C 9 2.4, 17 3.4, 24 2.8"></path><path d="M2 10 C 9 10.6, 17 9.4, 24 10.2"></path><path
        d="M2 17 C 9 16.4, 17 17.6, 24 17"></path></svg
    >
  </button>
</nav>

<div class="nav-panel" id="nav-panel" data-nav-panel hidden>
  <ul>
    {
      ui.nav.map((item, i) => (
        <li class="nav-panel__row">
          {item.children.length > 0 ? (
            <>
              <button type="button" class="nav-panel__link" aria-expanded="false" aria-controls={`nav-sub-${i}`} data-nav-sub>
                <span>{item.label}</span>
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="#542833" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 7 L9 12 L14 7" />
                </svg>
              </button>
              <ul class="nav-panel__sub" id={`nav-sub-${i}`} hidden>
                <li>
                  <a href={href(item.link)}>{item.label}</a>
                </li>
                {item.children.map((child) => (
                  <li>
                    <a href={href(child.link)}>{child.label}</a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <a href={href(item.link)} class="nav-panel__link">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .nav {
    position: fixed;
    top: 18px;
    left: 50%;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 18px 40px;
    background: rgba(217, 190, 194, 0.42);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: 999px;
    box-shadow: var(--shadow-nav);
    flex-wrap: nowrap;
    max-width: 92vw;
    transition:
      transform 0.35s ease,
      opacity 0.35s ease;
    transform: translateX(-50%) translateY(-140%);
    opacity: 0;
    pointer-events: none;
  }
  .nav.is-visible,
  .nav[data-always],
  .nav:focus-within {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  .nav__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    transition: transform var(--ease);
  }
  .nav__logo :global(img) {
    height: 36px;
    width: auto;
    max-width: none;
    display: block;
  }
  .nav__links {
    display: flex;
    gap: 22px;
    font-size: 18px;
    white-space: nowrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__item {
    position: relative;
  }
  .nav__link {
    color: var(--plum);
    text-decoration: none;
    font-weight: 400;
    display: inline-block;
    padding-bottom: 8px;
    margin-bottom: -8px;
    transition:
      transform 0.2s ease,
      color 0.2s ease,
      font-weight 0.2s ease;
  }
  .nav__link:hover,
  .nav__link:focus-visible {
    font-weight: 700;
    background-size: 100% 7px;
  }
  .nav__link.is-active {
    font-weight: 700;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav__logo:hover {
      transform: scale(1.12);
    }
    .nav__link:hover {
      transform: scale(1.1);
    }
  }

  /* Tendina: pillole che scendono una dopo l'altra */
  .nav__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding: 26px 0 0;
    margin: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    pointer-events: none;
    z-index: 60;
  }
  .nav__dropdown a {
    display: block;
    padding: 9px 20px;
    border-radius: 999px;
    background: rgba(246, 236, 238, 0.94);
    color: var(--plum);
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(84, 40, 51, 0.14);
    opacity: 0;
    transform: translateY(-10px) scale(0.85);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      background var(--ease);
  }
  .nav__dropdown a:hover {
    background: var(--blush);
  }
  .nav__item--parent:hover .nav__dropdown,
  .nav__item--parent:focus-within .nav__dropdown {
    pointer-events: auto;
  }
  .nav__item--parent:hover .nav__dropdown a,
  .nav__item--parent:focus-within .nav__dropdown a {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 0.05s), calc(var(--i) * 0.05s), 0s;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav__item--parent:hover .nav__dropdown a:hover {
      transform: scale(1.06);
      transition-delay: 0s;
    }
  }

  .nav__burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  /* Pannello mobile */
  .nav-panel {
    position: fixed;
    top: 84px;
    left: 4vw;
    right: 4vw;
    z-index: 49;
    background: rgba(246, 236, 238, 0.97);
    border-radius: 28px;
    padding: 10px 24px 14px;
    box-shadow: 0 14px 40px rgba(84, 40, 51, 0.2);
    max-height: calc(100vh - 110px);
    max-height: calc(100dvh - 110px);
    overflow-y: auto;
  }
  .nav-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-panel__row {
    border-bottom: 1px solid rgba(84, 40, 51, 0.12);
  }
  .nav-panel__row:last-child {
    border-bottom: none;
  }
  .nav-panel__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 54px;
    padding: 0;
    border: none;
    background: none;
    color: var(--plum);
    font-size: 19px;
    font-family: var(--font-body);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .nav-panel__link svg {
    transition: transform 0.2s ease;
  }
  .nav-panel__link[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .nav-panel__sub {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 0 0 16px 10px !important;
  }
  .nav-panel__sub[hidden] {
    display: none;
  }
  .nav-panel__sub a {
    display: block;
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--rose);
    color: var(--plum);
    font-size: 16px;
    text-decoration: none;
  }

  @media (max-width: 899px) {
    .nav,
    .nav.is-visible {
      transform: translateX(-50%);
      opacity: 1;
      pointer-events: auto;
      width: 92vw;
      justify-content: space-between;
      padding: 10px 14px 10px 24px;
    }
    .nav__links {
      display: none;
    }
    .nav__burger {
      display: flex;
    }
  }
  @media (min-width: 900px) {
    .nav-panel {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  if (nav && panel) {
    const burger = nav.querySelector<HTMLButtonElement>('.nav__burger')!;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
    const always = nav.hasAttribute('data-always');
    const orderedIds = [...document.querySelectorAll<HTMLElement>('main section[id]')].map((s) => s.id);

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', (open ? burger.dataset.labelClose : burger.dataset.labelOpen) || '');
      if (!open) {
        panel.querySelectorAll<HTMLButtonElement>('[data-nav-sub]').forEach((b) => {
          b.setAttribute('aria-expanded', 'false');
          document.getElementById(b.getAttribute('aria-controls')!)!.hidden = true;
        });
      }
    };
    burger.addEventListener('click', () => setOpen(panel.hasAttribute('hidden')));
    panel.querySelectorAll<HTMLButtonElement>('[data-nav-sub]').forEach((b) =>
      b.addEventListener('click', () => {
        const open = b.getAttribute('aria-expanded') !== 'true';
        panel.querySelectorAll<HTMLButtonElement>('[data-nav-sub]').forEach((o) => {
          o.setAttribute('aria-expanded', String(o === b && open));
          document.getElementById(o.getAttribute('aria-controls')!)!.hidden = !(o === b && open);
        });
      }),
    );
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', () => setOpen(false));

    let ticking = false;
    const update = () => {
      ticking = false;
      if (!always) nav.classList.toggle('is-visible', window.scrollY > 40);
      // Sezione attiva = l'ultima il cui bordo alto è sopra i 140px.
      let current: string | undefined;
      for (const id of orderedIds) {
        const el = document.getElementById(id);
        if (el && el.getClientRects().length && el.getBoundingClientRect().top <= 140) current = id;
      }
      links.forEach((a) => a.classList.toggle('is-active', !!current && a.dataset.navLink === current));
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
