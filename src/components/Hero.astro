---
import Img from './Img.astro';
import { single } from '../lib/content';
import { resolveFile } from '../lib/media';

const hero = await single('hero');
const ui = await single('ui');
const mp4 = resolveFile(hero.video);
const webm = resolveFile(hero.videoWebm);
---

<section id="hero" class="hero">
  {
    hero.poster && (
      <Img
        src={hero.poster}
        alt=""
        class="hero__media"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  {
    (mp4 || webm) && (
      <video class="hero__media" data-hero-video muted loop playsinline preload="none" aria-hidden="true">
        {webm && <source data-src={webm} type="video/webm" />}
        {mp4 && <source data-src={mp4} type="video/mp4" />}
      </video>
    )
  }
  <div class="hero__veil"></div>

  <a href="#chi-sono" class="hero__scroll" aria-label={ui.heroScroll}>
    <span class="hero__line hero__line--bottom" data-drop-bottom></span>
  </a>
  <span class="hero__drop" data-drop aria-hidden="true"></span>

  <div class="hero__content">
    <Img
      src={hero.logo}
      alt="The Flowers Travel"
      class="hero__logo"
      widths={[275, 550, 825]}
      sizes="275px"
      loading="eager"
    />
    <p class="hero__signature">{hero.signature}</p>
    <span class="hero__line hero__line--top" data-drop-top></span>
    <h1 class="hero__title">
      {hero.titleLine1}
      {
        hero.titleLine2 && (
          <>
            <br />
            <span class="hero__title-2">{hero.titleLine2}</span>
          </>
        )
      }
    </h1>
    <p class="hero__subtitle">{hero.subtitle}</p>
    <div class="hero__actions">
      <a href="#contatti" class="hero__btn hero__btn--fill">{hero.ctaPrimary}</a>
      <a href="#servizi" class="hero__btn hero__btn--outline">{hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 8vh var(--gutter);
    overflow: hidden;
    background: var(--ink);
  }
  .hero :global(.hero__media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    z-index: 0;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.35);
    z-index: 0;
  }
  .hero__scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 0 22px;
    color: var(--white);
    opacity: 0.85;
  }
  .hero__line {
    display: block;
    width: 1px;
    height: 55px;
  }
  .hero__line--bottom {
    background: rgba(255, 255, 255, 0.35);
  }
  .hero__line--top {
    position: relative;
    background: rgba(255, 255, 255, 0.5);
    margin: 0 0 44px;
  }
  .hero__drop {
    position: absolute;
    left: 50%;
    top: 0;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 0 10px 3px rgba(255, 255, 255, 0.9);
    z-index: 1;
    opacity: 0;
  }
  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 78vw;
    margin: 0 auto;
    color: var(--white);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__content :global(.hero__logo) {
    width: 275px;
    height: auto;
    margin-top: 50px;
    margin-bottom: -150px;
  }
  .hero__signature {
    font-family: var(--font-script);
    font-size: 56px;
    color: var(--white);
    margin: 0 0 44px;
  }
  .hero__title {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: clamp(44px, 8vw, 92px);
    line-height: 1.1;
    margin: -38px 0 28px;
    width: 70vw;
    max-width: 100%;
  }
  .hero__title-2 {
    white-space: nowrap;
  }
  .hero__subtitle {
    font-size: clamp(15px, 2.1vw, 22px);
    line-height: 1.6;
    white-space: nowrap;
    margin: 0 0 40px;
    opacity: 0.92;
  }
  .hero__actions {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 38px;
  }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 220px;
    color: var(--white);
    text-decoration: none;
    padding: 16px 32px;
    font-size: 18px;
    letter-spacing: 0.02em;
    transition:
      transform var(--ease),
      background var(--ease);
  }
  .hero__btn--fill {
    background: var(--blush);
    border: 1px solid var(--blush);
    border-radius: var(--petal);
  }
  .hero__btn--outline {
    background: transparent;
    border: 1px solid var(--white);
    border-radius: var(--petal-alt);
  }
  .hero__btn--outline:hover {
    background: rgba(255, 255, 255, 0.15);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__btn:hover {
      transform: scale(1.06);
    }
    .hero__btn:active {
      transform: scale(0.97);
    }
  }

  @media (max-width: 1279px) {
    .hero__subtitle {
      white-space: normal;
    }
  }
  @media (max-width: 759px) {
    .hero__content {
      max-width: 100%;
    }
    .hero__title {
      width: auto;
      font-size: clamp(34px, 10vw, 60px);
    }
    .hero__title-2 {
      white-space: normal;
    }
    .hero__signature {
      font-size: clamp(34px, 10vw, 44px);
      white-space: nowrap;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');
  const video = hero?.querySelector<HTMLVideoElement>('[data-hero-video]');

  // Video solo su schermi grandi e connessioni non lente: altrimenti resta l'immagine.
  if (video) {
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
      .connection;
    const slow = conn?.saveData || /(^|-)2g|3g/.test(conn?.effectiveType ?? '');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (matchMedia('(min-width: 760px)').matches && !slow && !reduced) {
      video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => (s.src = s.dataset.src!));
      video.load();
      video.play().catch(() => {});
    }
  }

  // Goccia luminosa che scende lungo le due linee (5s, infinito).
  const dot = hero?.querySelector<HTMLElement>('[data-drop]');
  const top = hero?.querySelector<HTMLElement>('[data-drop-top]');
  const bottom = hero?.querySelector<HTMLElement>('[data-drop-bottom]');
  let anim: Animation | undefined;

  function setupDrop() {
    if (!hero || !dot || !top || !bottom) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const h = hero.getBoundingClientRect();
    const t = top.getBoundingClientRect();
    const b = bottom.getBoundingClientRect();
    const topStart = t.top - h.top;
    const topEnd = t.bottom - h.top;
    const bottomStart = b.top - h.top;
    const bottomEnd = b.bottom - h.top;
    anim?.cancel();
    anim = dot.animate(
      [
        { top: topStart + 'px', opacity: 1, offset: 0, easing: 'cubic-bezier(0.6, 0, 0.8, 0.2)' },
        { top: topEnd + 'px', opacity: 1, offset: 0.4, easing: 'linear' },
        { top: topEnd + 'px', opacity: 0, offset: 0.44, easing: 'linear' },
        { top: bottomStart + 'px', opacity: 0, offset: 0.48, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' },
        { top: bottomStart + 'px', opacity: 1, offset: 0.52, easing: 'cubic-bezier(0.2, 0.8, 0.6, 1)' },
        { top: bottomEnd + 'px', opacity: 1, offset: 0.96, easing: 'linear' },
        { top: bottomEnd + 'px', opacity: 0, offset: 1 },
      ],
      { duration: 5000, iterations: Infinity },
    );
  }

  setupDrop();
  document.fonts?.ready.then(setupDrop);
  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(setupDrop, 120);
  });
</script>
