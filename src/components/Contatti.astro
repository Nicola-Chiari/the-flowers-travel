---
import GoldWave from './GoldWave.astro';
import { single } from '../lib/content';

const c = await single('contatti');
const f = (await single('ui')).form;
---

<section id="contatti" class="contact">
  <div class="contact__box" data-contact>
    <GoldWave class="contact__wave" />
    <h2 class="contact__title">{c.title}</h2>
    <p class="contact__text">{c.text}</p>

    <form
      id="contatti-form"
      class="contact__form"
      name="contatto"
      method="POST"
      action="/grazie"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-contact-form
      data-error-send={f.errorSend}
      data-sending={f.sending}
    >
      <input type="hidden" name="form-name" value="contatto" />
      <input type="hidden" name="subject" value={f.emailSubject} />
      <p class="sr-only" aria-hidden="true">
        <label>Bot <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <div class="contact__row">
        <label class="contact__field">
          <span class="sr-only">{f.name}</span>
          <input type="text" name="nome" autocomplete="given-name" placeholder={f.name} required data-error={f.errorName} />
        </label>
        <label class="contact__field">
          <span class="sr-only">{f.surname}</span>
          <input type="text" name="cognome" autocomplete="family-name" placeholder={f.surname} />
        </label>
      </div>
      <div class="contact__row">
        <label class="contact__field">
          <span class="sr-only">{f.email}</span>
          <input type="email" name="email" autocomplete="email" placeholder={f.email} required data-error={f.errorEmail} />
        </label>
        <label class="contact__field">
          <span class="sr-only">{f.phone}</span>
          <input type="tel" name="telefono" autocomplete="tel" placeholder={f.phone} />
        </label>
      </div>
      <label class="contact__field">
        <span class="sr-only">{f.message}</span>
        <textarea name="messaggio" rows="8" placeholder={f.message} required data-error={f.errorMessage}></textarea>
      </label>
      <label class="contact__consent">
        <input type="checkbox" name="privacy" value="sì" required data-error={f.errorConsent} />
        <span>{f.consentBefore}<a href="/privacy" target="_blank">{f.consentLink}</a>{f.consentAfter}</span>
      </label>

      <p class="contact__error" data-form-status role="alert" hidden></p>
      <button type="submit" class="contact__submit">{c.submitButton}</button>
    </form>

    <p class="contact__success" data-contact-success role="status" tabindex="-1" hidden>{c.successMessage}</p>
  </div>
</section>

<style>
  .contact {
    padding: 110px var(--gutter);
    background: var(--white);
  }
  .contact__box {
    max-width: 800px;
    margin: 0 auto;
    background: var(--rose);
    border-radius: 40px;
    padding: 64px clamp(24px, 6vw, 64px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .contact__box :global(.contact__wave) {
    margin-bottom: 28px;
    max-width: 100%;
  }
  .contact__title {
    font-family: var(--font-title);
    font-weight: 600;
    font-size: clamp(30px, 4.4vw, 46px);
    line-height: 1.15;
    color: var(--olive);
    margin: 0 0 22px;
    max-width: 520px;
    text-wrap: balance;
  }
  .contact__text {
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink);
    max-width: 620px;
    margin: 0 0 40px;
    text-wrap: pretty;
  }
  .contact__form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 22px;
    text-align: left;
  }
  .contact__form[hidden] {
    display: none;
  }
  .contact__row {
    display: flex;
    flex-wrap: wrap;
    gap: 22px 28px;
  }
  .contact__row .contact__field {
    flex: 1 1 240px;
    min-width: 0;
  }
  .contact__field {
    display: block;
  }
  .contact__field input,
  .contact__field textarea {
    width: 100%;
    border: 1px solid transparent;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 15px;
    letter-spacing: 0.12em;
    outline: none;
  }
  .contact__field input {
    height: 60px;
    padding: 0 26px;
    border-radius: 999px;
  }
  .contact__field textarea {
    display: block;
    min-height: 220px;
    padding: 20px 26px;
    border-radius: 30px;
    line-height: 1.6;
    resize: vertical;
  }
  .contact__field input::placeholder,
  .contact__field textarea::placeholder {
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.55);
  }
  .contact__field input:focus,
  .contact__field textarea:focus {
    border-color: var(--olive);
  }
  .contact__form [aria-invalid='true'] {
    border-color: var(--error);
    outline: 1px solid var(--error);
  }
  .contact__consent {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    margin-top: 6px;
  }
  .contact__consent input {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: var(--olive);
    margin: 0;
  }
  .contact__consent a {
    color: var(--olive);
    text-decoration: underline;
  }
  .contact__error {
    margin: 0;
    font-size: 15px;
    color: var(--error);
  }
  .contact__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 55px;
    margin: 8px 38px 0;
    border: none;
    border-radius: 999px;
    background: var(--olive);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 14.2px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform var(--ease),
      background var(--ease);
  }
  .contact__submit:hover {
    background: var(--plum);
  }
  .contact__submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact__submit:hover {
      transform: scale(1.02);
    }
    .contact__submit:active {
      transform: scale(0.98);
    }
  }
  .contact__success {
    font-family: var(--font-script);
    font-size: 40px;
    color: var(--olive);
    margin: 10px 0;
  }
  @media (max-width: 759px) {
    .contact {
      padding: 90px var(--gutter);
    }
    .contact__box {
      border-radius: 28px;
    }
    .contact__submit {
      margin: 8px 0 0;
    }
    .contact__consent {
      letter-spacing: 0.06em;
      align-items: flex-start;
    }
  }
</style>

<script>
  import { enhanceForm } from '../scripts/forms';

  const box = document.querySelector<HTMLElement>('[data-contact]');
  const form = box?.querySelector<HTMLFormElement>('[data-contact-form]');
  const success = box?.querySelector<HTMLElement>('[data-contact-success]');
  if (form && success) {
    enhanceForm(form, () => {
      form.hidden = true;
      success.hidden = false;
      success.focus();
    });
  }
</script>
