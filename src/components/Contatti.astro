---
import { single, slugify } from '../lib/content';

const c = await single('contatti');
const site = await single('site');
const ui = await single('ui');
const f = ui.form;
const questions = c.questions.map((q, i) => ({ ...q, name: slugify(q.label) || `domanda-${i + 1}` }));
---

<section id="contatti" class="contact">
  <div class="contact__wrap">
    <div class="contact__box" data-contact>
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#d9bec2" stroke-width="1.4" aria-hidden="true"
        ><path d="M6 2h9l3 3v17H6z"></path><path d="M9 8h6M9 12h6M9 16h4"></path></svg
      >
      <p class="contact__eyebrow">{c.eyebrow}</p>
      <h2 class="contact__title">{c.title}</h2>
      <p class="contact__text">{c.text}</p>

      <a href="#contatti-form" class="contact__open" data-contact-open>{c.openButton}</a>

      <form
        id="contatti-form"
        class="contact__form"
        name="contatto"
        method="POST"
        action="/grazie"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-contact-form
        data-error-email={f.errorEmail}
        data-error-consent={f.errorConsent}
        data-error-send={f.errorSend}
        data-sending={f.sending}
      >
        <input type="hidden" name="form-name" value="contatto" />
        <input type="hidden" name="subject" value={f.emailSubject} />
        <p class="sr-only" aria-hidden="true">
          <label>Bot <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        {
          questions.map((q) => (
            <label class="contact__field">
              {q.label}
              <input type="text" name={q.name} placeholder={q.placeholder || undefined} />
            </label>
          ))
        }
        <label class="contact__field">
          {f.nameLabel}
          <input type="text" name="nome" autocomplete="name" placeholder={f.namePlaceholder || undefined} />
        </label>
        <label class="contact__field">
          {f.emailLabel} *
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
            placeholder={f.emailPlaceholder || undefined}
          />
        </label>
        <label class="contact__field">
          {f.phoneLabel}
          <input type="tel" name="telefono" autocomplete="tel" placeholder={f.phonePlaceholder || undefined} />
        </label>
        <label class="contact__consent">
          <input type="checkbox" name="privacy" value="sì" required />
          <span>
            {f.consentBefore}<a href="/privacy" target="_blank">{f.consentLink}</a>{f.consentAfter}
          </span>
        </label>

        <p class="contact__error" data-form-status role="alert" hidden></p>
        <button type="submit" class="contact__submit">{c.submitButton}</button>
      </form>

      <p class="contact__success" data-contact-success role="status" hidden>{c.successMessage}</p>
    </div>

    <p class="contact__channels-title">{c.otherChannels}</p>
    <div class="contact__channels">
      <a href={`tel:${site.phoneLink}`} class="contact__channel">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7D8F90" stroke-width="1.8" aria-hidden="true"
          ><path
            d="M6.6 10.8a15.9 15.9 0 0 0 6.6 6.6l2.2-2.2a1.2 1.2 0 0 1 1.3-.3c1.3.5 2.7.8 4.1.9a1.2 1.2 0 0 1 1.1 1.2v3.6a1.2 1.2 0 0 1-1.2 1.2C10.5 21.8 2.2 13.5 2.2 3.2A1.2 1.2 0 0 1 3.4 2H7a1.2 1.2 0 0 1 1.2 1.1c.1 1.4.4 2.8.9 4.1a1.2 1.2 0 0 1-.3 1.3z"
          ></path></svg
        >
        <div>
          <p class="contact__channel-label">{ui.channels.phone}</p>
          <p class="contact__channel-value">{site.phone}</p>
        </div>
      </a>
      <a href={`mailto:${site.email}`} class="contact__channel">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7D8F90" stroke-width="1.8" aria-hidden="true"
          ><path d="M3 5h18v14H3z"></path><path d="M3 6l9 7 9-7"></path></svg
        >
        <div>
          <p class="contact__channel-label">{ui.channels.email}</p>
          <p class="contact__channel-value">{site.email}</p>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 110px var(--gutter);
    background: var(--white);
  }
  .contact__wrap {
    max-width: 800px;
    margin: 0 auto;
  }
  .contact__box {
    background: var(--ink);
    color: var(--white);
    padding: 64px 48px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .contact__box > svg {
    margin-bottom: 20px;
  }
  .contact__eyebrow {
    font-family: var(--font-script);
    font-size: 46px;
    letter-spacing: 0.02em;
    font-weight: 600;
    color: var(--blush);
    margin: 0 0 20px;
  }
  .contact__title {
    font-family: var(--font-title);
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 36px);
    margin: 0 0 20px;
    max-width: 480px;
  }
  .contact__text {
    font-size: 18px;
    line-height: 1.7;
    opacity: 0.85;
    max-width: 460px;
    margin: 0 0 36px;
  }
  .contact__open {
    display: none;
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    padding: 16px 36px;
    border-radius: var(--petal);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition:
      transform var(--ease),
      background var(--ease),
      color var(--ease);
  }
  .contact__open:hover {
    background: var(--blush);
    color: var(--white);
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact__open:hover {
      transform: scale(1.05);
    }
    .contact__open:active {
      transform: scale(0.97);
    }
  }
  /* Con JS: pulsante visibile e modulo chiuso finché non si clicca. */
  :global(.js) .contact__open {
    display: inline-block;
  }
  :global(.js) .contact__form {
    display: none;
  }
  :global(.js) .contact__box.is-open .contact__open {
    display: none;
  }
  :global(.js) .contact__box.is-open .contact__form {
    display: flex;
  }
  :global(.js) .contact__box.is-sent .contact__form {
    display: none;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 420px;
    width: 100%;
    text-align: left;
    margin-top: 8px;
  }
  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    opacity: 0.8;
  }
  .contact__field input {
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.06);
    color: var(--white);
    font-family: var(--font-body);
    font-size: 18px;
  }
  .contact__field input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }
  .contact__field input[aria-invalid='true'],
  .contact__consent input[aria-invalid='true'] {
    border-color: var(--blush);
    outline: 1px solid var(--blush);
  }
  .contact__consent {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.8;
  }
  .contact__consent input {
    margin: 3px 0 0;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: var(--blush);
  }
  .contact__consent a {
    color: var(--white);
    text-decoration-color: var(--blush);
    text-underline-offset: 3px;
  }
  .contact__error {
    margin: 0;
    color: var(--blush);
    font-size: 16px;
  }
  .contact__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--blush);
    color: var(--white);
    border: none;
    padding: 16px 32px;
    border-radius: var(--petal);
    font-size: 18px;
    letter-spacing: 0.02em;
    margin-top: 8px;
    cursor: pointer;
    transition: transform var(--ease);
  }
  .contact__submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  @media (prefers-reduced-motion: no-preference) {
    .contact__submit:hover {
      transform: scale(1.05);
    }
    .contact__submit:active {
      transform: scale(0.97);
    }
  }
  .contact__success {
    margin: 0;
    font-size: 19px;
    line-height: 1.7;
    max-width: 420px;
  }

  .contact__channels-title {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.5;
    margin: 56px 0 20px;
  }
  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact__channel {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid rgba(26, 26, 26, 0.12);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--ease);
  }
  .contact__channel:hover {
    background: rgba(125, 144, 144, 0.08);
  }
  .contact__channel svg {
    flex-shrink: 0;
  }
  .contact__channel-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 3px;
  }
  .contact__channel-value {
    margin: 0;
    font-size: 18px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 759px) {
    .contact__box {
      padding: 48px 24px;
    }
    .contact__eyebrow {
      font-size: 36px;
    }
  }
</style>

<script>
  import { enhanceForm } from '../scripts/forms';

  const box = document.querySelector<HTMLElement>('[data-contact]');
  const form = box?.querySelector<HTMLFormElement>('[data-contact-form]');
  const success = box?.querySelector<HTMLElement>('[data-contact-success]');

  box?.querySelector('[data-contact-open]')?.addEventListener('click', (e) => {
    e.preventDefault();
    box.classList.add('is-open');
    form?.querySelector<HTMLInputElement>('input:not([type="hidden"]):not([tabindex="-1"])')?.focus();
  });

  if (box && form && success) {
    enhanceForm(form, () => {
      box.classList.add('is-sent');
      success.hidden = false;
      success.setAttribute('tabindex', '-1');
      success.focus();
    });
  }
</script>
